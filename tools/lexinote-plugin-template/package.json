{
  "name": "lexinote-sample-plugin",
  "version": "1.0.0",
  "description": "Template plugin for LexiNote",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node ../../lexi-cli/lexi.cjs plugin build .",
