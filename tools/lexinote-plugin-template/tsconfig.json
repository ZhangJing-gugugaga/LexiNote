{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2021", "DOM"],
    "baseUrl": ".",
    "paths": {
      "lexinote": ["./lexinote.d.ts"],
      "obsidian": ["./lexinote.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "lexinote.d.ts"]
}
