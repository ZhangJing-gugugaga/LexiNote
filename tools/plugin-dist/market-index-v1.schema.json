{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lexinote.app/schema/market-index-v1.json",
  "title": "LexiNote community plugin index v1",
  "description": "The single plugin index schema. tools/plugin-dist/market-index-v1.cjs implements it for Node (export + gate), and entry/src/main/ets/core/plugin/LexiPluginMarketModel.ets is the ArkTS twin that the client actually runs. scripts/tests/plugin-dist-regression.cjs feeds both the same fixture matrix and fails on any divergence.",
  "type": "object",
  "required": [
    "schemaVersion",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/plugin"
      }
    }
  },
  "definitions": {
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "author",
        "sha256",
        "zipUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "zipUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "minApiVersion": {
          "type": "string"
        },
        "isDesktopOnly": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "network": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fs": {
              "type": "boolean"
            },
            "clipboard": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
